# Exemplo de configuração local. Todos os valores abaixo são exemplos de
# desenvolvimento, não segredos reais. Não reutilize nada disto fora da sua máquina.
#
# Como é usado:
#   - `docker compose` lê um arquivo `.env` na raiz (ignorado pelo git) para as
#     variáveis ${...} do docker-compose.yml: senhas, portas e LOG_LEVEL.
#     Copie com `cp .env.example .env` apenas se quiser mudar algum valor.
#   - Os containers `wallet` recebem do compose só LOG_LEVEL e os valores fixos do
#     docker-compose.yml (DATABASE_URL, HTTP_ADDR, OIDC_*, AWS_*, SQS_ENDPOINT e os
#     perfis SQS). As demais variáveis (DB_*, HTTP_*, SQS_*, OUTBOX_*, ...) só valem
#     para o binário rodando fora do compose, com os padrões de internal/platform/config
#     quando não definidas. Exemplo: `set -a; . ./.env; set +a; go run ./cmd/wallet`.
#   - Durações usam a sintaxe do Go (500ms, 5s, 2m), entre 1ms e 24h.

# --- Banco (PostgreSQL) -------------------------------------------------------
# Senha do superusuário e das duas roles criadas pelo init (deploy/postgres/initdb).
# O init roda só quando o volume pgdata está vazio: mudar estas senhas depois exige
# recriar o volume (`docker compose down -v`, que apaga os dados).
POSTGRES_PASSWORD=postgres
WALLET_OWNER_PASSWORD=wallet_owner
WALLET_APP_PASSWORD=wallet_app
# Aplicação rodando no host (a porta 5432 é a do compose). A URL é obrigatória.
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wallet?sslmode=disable
# Tamanho do pool, lock_timeout e statement_timeout de cada transação.
DB_MAX_OPEN_CONNS=20
DB_LOCK_TIMEOUT=5s
DB_STATEMENT_TIMEOUT=10s

# --- HTTP ---------------------------------------------------------------------
# No compose o wallet escuta em :8080 dentro do container (sem porta no host; o
# acesso é pelo nginx). No host, a 8080 é do Keycloak, então use outra porta.
# O padrão do binário, sem esta variável, é :8080.
HTTP_ADDR=:8090
# Prazo para drenar requisições em andamento no desligamento.
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Log ----------------------------------------------------------------------
# debug, info, warn ou error.
LOG_LEVEL=info

# --- OIDC (Keycloak) ----------------------------------------------------------
# Issuer público: é o valor do claim `iss` dos tokens. Obrigatório quando HTTP_ENABLED=true.
OIDC_ISSUER_URL=http://localhost:8080/realms/wallet
# Onde buscar as chaves (JWKS). Vazio = <OIDC_ISSUER_URL>/protocol/openid-connect/certs.
# No compose o wallet usa o host interno http://keycloak:8080/realms/wallet/protocol/openid-connect/certs.
OIDC_JWKS_URL=
# Audience exigida no token.
OIDC_AUDIENCE=wallet-api

# --- SQS e AWS (MiniStack) ----------------------------------------------------
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
# Credenciais geradas pelo ministack_init (perfis wallet-consumer e wallet-publisher).
# O arquivo é recriado, com chaves novas, a cada provisionamento.
AWS_SHARED_CREDENTIALS_FILE=.local/ministack/credentials
# ATENÇÃO: deixar SQS_CONSUMER_PROFILE e SQS_PUBLISHER_PROFILE vazios faz o SDK usar a
# credencial padrão (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ou o perfil default). No
# MiniStack isso é o root da conta dona das filas, o que ANULA o menor privilégio:
# o consumidor e o publicador passariam a poder tudo. Mantenha os perfis preenchidos.
SQS_CONSUMER_PROFILE=wallet-consumer
SQS_PUBLISHER_PROFILE=wallet-publisher
# Só se os perfis ficarem vazios (exemplo: testes com o root do MiniStack):
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# Nomes das filas FIFO criadas por deploy/ministack/provision.sh.
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
# Consumidor: goroutines por instância, long polling (1s a 20s) e mensagens por
# recebimento (1 a 10).
SQS_CONSUMER_WORKERS=4
SQS_WAIT_TIME=20s
SQS_MAX_MESSAGES=10
# Backoff do retry por ApproximateReceiveCount. O mínimo da base é 1s (a visibilidade
# é em segundos inteiros) e o teto vai até 12h.
SQS_RETRY_BASE_DELAY=2s
SQS_RETRY_MAX_DELAY=5m
# Prazo para o consumidor concluir o trabalho em andamento no desligamento.
SQS_SHUTDOWN_TIMEOUT=20s
# SenderId (conta AWS remetente) = providerId, no formato conta=provedor,conta=provedor.
# O providerId tem no máximo 64 bytes. Vazio usa o padrão abaixo.
SQS_SENDER_PROVIDER_MAP=111111111111=provider-a,222222222222=provider-b

# --- Toggles de componentes ---------------------------------------------------
# true, false, 1 ou 0 (vazio = true). Servem para processos dedicados e testes.
# Sem HTTP não há /metrics nem /health no processo.
HTTP_ENABLED=true
CONSUMER_ENABLED=true
OUTBOX_ENABLED=true
REFWORKER_ENABLED=true

# --- Outbox -------------------------------------------------------------------
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
# Lease de cada lote. O timeout de cada publicação é OUTBOX_LEASE/2.
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=5m
OUTBOX_SHUTDOWN_TIMEOUT=10s

# --- Worker de referências pendentes ------------------------------------------
REFWORKER_POLL_INTERVAL=1s
REFWORKER_SHUTDOWN_TIMEOUT=10s
# Espera por uma referência ausente: backoff base x2 até o teto, e número máximo de
# tentativas (a primeira, síncrona, conta como 1). O teto deve ser >= à base.
REFERENCE_RETRY_BASE_DELAY=2s
REFERENCE_RETRY_MAX_DELAY=5m
REFERENCE_RETRY_MAX_ATTEMPTS=10

# --- Portas do compose (host) -------------------------------------------------
WALLET_PORT=8000
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
MINISTACK_PORT=4566
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Profile `test`.
POSTGRES_TEST_PORT=5433
KEYCLOAK_TEST_PORT=8081
MINISTACK_TEST_PORT=4567

# --- Senhas locais ------------------------------------------------------------
# Admin do Keycloak (usuário admin) e do Grafana (usuário admin).
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_PASSWORD=admin
